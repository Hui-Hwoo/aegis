{
 "defaultEffect": "deny",
 "mode": "enforce",
 "rules": [
  {
   "actions": [
    "read_file"
   ],
   "effect": "allow",
   "id": "analyst-read-docs",
   "resources": [
    "fs:docs/**",
    "fs:tmp/**"
   ],
   "roles": [
    "analyst"
   ]
  },
  {
   "actions": [
    "db_query"
   ],
   "effect": "allow",
   "id": "analyst-query-analytics",
   "resources": [
    "db:analytics.*"
   ],
   "roles": [
    "analyst"
   ]
  },
  {
   "actions": [
    "write_file"
   ],
   "effect": "allow",
   "id": "analyst-write-tmp",
   "resources": [
    "fs:tmp/**"
   ],
   "roles": [
    "analyst"
   ]
  },
  {
   "actions": [
    "write_file"
   ],
   "effect": "allow",
   "id": "docs-need-approval",
   "requireApproval": true,
   "resources": [
    "fs:docs/**"
   ],
   "roles": [
    "analyst"
   ]
  },
  {
   "actions": [
    "db_delete"
   ],
   "effect": "allow",
   "id": "staging-delete-needs-approval",
   "requireApproval": true,
   "resources": [
    "db:staging.*"
   ],
   "roles": [
    "analyst"
   ]
  },
  {
   "actions": [
    "db_query"
   ],
   "effect": "allow",
   "id": "prod-query-needs-approval",
   "requireApproval": true,
   "resources": [
    "db:prod.*"
   ],
   "roles": [
    "analyst"
   ]
  },
  {
   "actions": [
    "send_email"
   ],
   "effect": "allow",
   "id": "external-email-needs-approval",
   "requireApproval": true,
   "resources": [
    "api:email.external"
   ],
   "roles": [
    "analyst"
   ]
  },
  {
   "actions": [
    "send_email"
   ],
   "effect": "allow",
   "id": "internal-email",
   "resources": [
    "api:email.internal"
   ],
   "roles": [
    "analyst"
   ]
  },
  {
   "actions": [
    "memory_read",
    "memory_write"
   ],
   "effect": "allow",
   "id": "memory-governed",
   "resources": [
    "memory:*"
   ],
   "roles": [
    "analyst"
   ]
  },
  {
   "actions": [
    "read_file",
    "write_file"
   ],
   "effect": "deny",
   "id": "protect-secrets",
   "resources": [
    "fs:secrets/**",
    "fs:/etc/**"
   ]
  },
  {
   "actions": [
    "db_delete"
   ],
   "effect": "deny",
   "id": "protect-prod",
   "resources": [
    "db:prod.*"
   ],
   "roles": [
    "analyst",
    "intern"
   ]
  },
  {
   "id": "admin-read-docs",
   "effect": "allow",
   "actions": [
    "read_file"
   ],
   "resources": [
    "fs:docs/**"
   ],
   "roles": [
    "admin"
   ]
  },
  {
   "id": "admin-query-analytics",
   "effect": "allow",
   "actions": [
    "db_query"
   ],
   "resources": [
    "db:analytics.**"
   ],
   "roles": [
    "admin"
   ]
  },
  {
   "id": "admin-prod-delete-needs-approval",
   "effect": "allow",
   "actions": [
    "db_delete"
   ],
   "resources": [
    "db:prod.*"
   ],
   "roles": [
    "admin"
   ],
   "requireApproval": true
  },
  {
   "id": "intern-read-docs",
   "effect": "allow",
   "actions": [
    "read_file"
   ],
   "resources": [
    "fs:docs/**"
   ],
   "roles": [
    "intern"
   ]
  }
 ],
 "version": 1
}